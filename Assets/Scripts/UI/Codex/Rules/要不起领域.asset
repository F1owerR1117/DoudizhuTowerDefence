  m_Script: {fileID: 11500000, guid: e427239fb1e427f44b234fc4c60a6aff, type: 3}
  m_Name: "\u8981\u4E0D\u8D77\u9886\u57DF"
  m_EditorClassIdentifier: 
  Id: rule-pass-domain
  DisplayName: "\u8981\u4E0D\u8D77\u9886\u57DF"
  Category: 5
  Icon: {fileID: 21300000, guid: 981190a9e6b8710428bf85ae6113fcd1, type: 3}
  Description: "\u6FC0\u6D3B\u540E\u4E0B\u4E00\u6B21\u6253\u51FA\u624B\u724C\u89E6\u53D1\u6301\u7EED\u4E00\u5B9A\u65F6\u95F4\u7684\u8981\u4E0D\u8D77\u9886\u57DF\n\u654C\u65B9\u53EA\u80FD\u6253\u51FA\u724C\u578B/\u724C\u503C\u5927\u4E8E\u8BE5\u624B\u724C\u7684\u724C,\u4E0D\u7B26\u5408\u8BE5\u89C4\u5219\u7684\u624B\u724C\u7686\u88AB\u5C01\u5370\n\u70B8\u5F39/\u53CD\u5236\u62A4\u76FE
    \u4F1A\u76F4\u63A5\u51FB\u7834\u8981\u4E0D\u8D77\u9886\u57DF\n\u5355\u5F20\u624B\u724C\u65E0\u6CD5\u89E6\u53D1\u8981\u4E0D\u8D77\u9886\u57DF"
  ExtraInfo: "\u4F8B\u5982:\u6FC0\u6D3B\u8981\u4E0D\u8D77\u9886\u57DF\u540E,\u6253\u51FA\u5BF9\u5B508\n\u654C\u65B9\u5219\u53EA\u80FD\u6253\u51FA\u5BF9\u5B509\u300110\u53CA\u724C\u503C\u66F4\u5927\u7684\u5BF9\u5B50\u6216\u70B8\u5F39,\u65E0\u6CD5\u6253\u51FA\u5176\u5B83\u624B\u724C\n\u6FC0\u6D3B\u8981\u4E0D\u8D77\u9886\u57DF\u540E\u6253\u51FA\u70B8\u5F399\n\u654C\u65B9\u53EA\u80FD\u6253\u51FA10\u3001J\u53CA\u724C\u503C\u66F4\u5927\u7684\u70B8\u5F39,\u65E0\u6CD5\u6253\u51FA\u5176\u4ED6\u624B\u724C\n\u8981\u4E0D\u8D77\u9886\u57DF\u5728\u654C\u65B9\u6210\u529F\u6253\u51FA\u70B8\u5F39/\u89E6\u53D1\u53CD\u5236\u62A4\u76FE\u4F1A\u88AB\u63D0\u524D\u7834\u9664"
  Keywords:
  - "\u8981\u4E0D\u8D77"
  - "\u9886\u57DF"
  - "\u89C4\u5219"
  RelatedEntries: []
